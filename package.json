{
    "name": "outpost",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "typecheck": "turbo run typecheck",
        "db:generate": "turbo run db:generate --filter=@copilotkit/outpost",
        "db:push": "turbo run db:push --filter=@copilotkit/outpost",
        "db:seed": "turbo run db:seed --filter=@copilotkit/outpost",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
    },
    "dependencies": {
        "@copilotkit/outpost": "workspace:*"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@linear/sdk": "^81.0.0",
        "@typescript-eslint/eslint-plugin": "^8.58.2",
        "@typescript-eslint/parser": "^8.58.2",
        "eslint": "^9.16.0",
        "prettier": "^3.2.0",
        "tsx": "^4.21.0",
        "turbo": "^2.3.0",
        "typescript": "^5.7.0",
        "vitest": "^4.1.4"
    },
    "packageManager": "pnpm@10.33.4",
    "engines": {
        "node": ">=20.0.0"
    }
}
