# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://outpost:outpost@localhost:5432/outpost?schema=public"
DB_CONNECTION_LIMIT=5         # Max DB connections per service

# ─── Auth (NextAuth.js) ─────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-string"
# Provider: "credentials" (default), "github", or "oidc"
AUTH_PROVIDER="credentials"
NEXT_PUBLIC_AUTH_PROVIDER="credentials"
# GitHub provider (only needed if AUTH_PROVIDER=github)
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GITHUB_ALLOWED_ORG=""
# ALLOWED_EMAIL_DOMAIN=""
# OIDC provider (only needed if AUTH_PROVIDER=oidc)
# OIDC_ISSUER=""
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""

# ─── AI Pipeline ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""             # Pathfinder embeddings (text-embedding-3-small)
PATHFINDER_URL="http://localhost:3100"
PATHFINDER_MCP_URL=           # Pathfinder knowledge base URL
FALLBACK_DOCS_URL=            # Fallback documentation URL
AI_RESPONSE_MODEL=            # Override AI response model (default: claude-sonnet-4-20250514)
AI_CONFIDENCE_MODEL=          # Override confidence scoring model
AI_CLASSIFIER_MODEL=          # Override ticket classifier model
AI_SENTIMENT_MODEL=           # Override sentiment analysis model
AI_QUERY_DISTILLER_MODEL=     # Override the docs-search query distiller model

# ─── Shadow Mode ─────────────────────────────────────────────────────────────
# Set to 'true' to run the full AI pipeline but LOG responses instead of posting
# them to Discord/GitHub/Slack/Teams. TWO services read this flag and each gates a
# different point in the flow:
#   - outpost-discord-bot gates at INGEST (thread-create.ts, message-create.ts
#     divert to the silent shadow path)
#   - outpost-worker gates at POST-BACK (the AI_RESPONSE handler checks it right
#     before adapter.postResponse, and it also gates ONBOARDING_DIGEST)
# For Discord either gate alone stops a post. The worker's gate is the one that
# covers EVERY platform (GitHub, Slack, Teams) plus the digest job, so staging
# must have it set on outpost-worker — not only on a bot.
# Staging runs SHADOW_MODE=true; production runs false.
SHADOW_MODE=false

# ─── Discord Bot ─────────────────────────────────────────────────────────────
DISCORD_TOKEN=""              # Bot token used by discord-mcp
DISCORD_BOT_TOKEN=""          # Bot token used by the discord-bot app
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""      # OAuth client secret (dashboard Discord login)
DISCORD_MCP_TOKEN=""          # Shared secret guarding the discord-mcp server
MONITORED_CHANNEL_IDS=""      # Forum/channel IDs the bot answers in. REQUIRED — empty means no channels
DISCORD_DIGEST_CHANNEL_ID=    # Channel for onboarding digest posts
# Guild (server) IDs per community — replaces the old single GUILD_ID
DISCORD_GUILD_COPILOTKIT=     # CopilotKit Discord server ID
DISCORD_GUILD_AGUI=           # AG-UI Discord server ID
# Monitored channel IDs per community
DISCORD_CHANNEL_CK_GENERAL=   # CopilotKit #general
DISCORD_CHANNEL_CK_SUPPORT=   # CopilotKit support channel
DISCORD_CHANNEL_AGUI_SUPPORT= # AG-UI support channel
DISCORD_CHANNEL_AGUI_BUILDING= # AG-UI building channel

# ─── Slack Bot ───────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=
SLACK_SOCKET_MODE=true

# ─── Teams Bot ───────────────────────────────────────────────────────────────
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_TENANT_ID=              # optional, for single-tenant apps

# ─── GitHub App ──────────────────────────────────────────────────────────────
GITHUB_APP_ID=""
GITHUB_PRIVATE_KEY=""
GITHUB_INSTALLATION_ID=""
GITHUB_WEBHOOK_SECRET=""
GITHUB_TEAM_LOGINS=""
# Comma-separated "owner/repo" list the bot is allowed to respond on.
# Defaults to CopilotKit/CopilotKit so it never answers issues on other repos
# it's installed on (e.g. CopilotKit/outpost).
GITHUB_ALLOWED_REPOS="CopilotKit/CopilotKit"

# ─── Linear Sync ─────────────────────────────────────────────────────────────
LINEAR_API_KEY=
LINEAR_WEBHOOK_SECRET=
LINEAR_TEAM_ID=

# ─── HubSpot CRM ─────────────────────────────────────────────────────────────
HUBSPOT_API_KEY=

# ─── Email (Postmark - managed) ──────────────────────────────────────────────
# POSTMARK_SERVER_TOKEN=""        # Postmark server API token
# POSTMARK_WEBHOOK_TOKEN=""       # Webhook auth token (required in production)

# ─── Email (SMTP - self-hosted alternative) ──────────────────────────────────
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""

# ─── Monitoring ──────────────────────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
LOG_LEVEL="info"

# ─── Worker ──────────────────────────────────────────────────────────────────
HEALTH_PORT=3005              # Health check port — read by FIVE services (worker,
                              # discord-bot, slack-bot, teams-bot, linear-sync), so one
                              # value here moves all of them onto the same port; it
                              # cannot separate them. Deployed images pin their own
                              # (discord 3001, slack 3002, teams 3003, worker 3005).
                              # Running several locally needs a per-process override.

# OUTPOST_ALLOW_SCHEMA_DRIFT=1  # Incident release valve for apps/worker/start.sh.
                              # The worker refuses to boot when the live database does
                              # not match schema.prisma, or when that check cannot run
                              # at all. Setting this (1/true/yes/on) starts it anyway,
                              # with warnings. Use it for transient skew while a sibling
                              # service is mid-rollout, or to get the worker up during
                              # an incident; unset it once the schema is repaired.
                              # TRACKER_SYNC may write wrong statuses to Linear while
                              # this is set.

# OUTPOST_STARTUP_STEP_TIMEOUT=180  # Seconds the worker's schema-drift check may run
                              # before it is abandoned (apps/worker/start.sh). Bounds
                              # only the read-only check; `migrate deploy` is left
                              # unbounded on purpose, since killing it mid-migration
                              # creates the P3009 failed-migration state the guard
                              # exists to report. Keep it below the platform's
                              # healthcheck timeout, or a slow check is killed as an
                              # unexplained deploy failure instead of logging a reason.

# ─── Railway ─────────────────────────────────────────────────────────────────
# Railway auto-deploys from GitHub; no deploy hook needed.
# RAILWAY_TOKEN is only needed for CLI-based deploys (e.g. `railway up`).
# RAILWAY_TOKEN=""
#
# Production runtime vars are managed in the Railway dashboard (per-service),
# not here. They surface locally as RAILWAY_PROD_* when you run
# `railway variables` / pull. Do NOT commit real RAILWAY_PROD_* values.
