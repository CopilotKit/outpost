{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        // Node runs dist/ directly with no bundler. The root config uses
        // "bundler" resolution, which does not require the .js extension on
        // relative imports - so `from './foo'` would typecheck, lint, build and
        // pass vitest, then ERR_MODULE_NOT_FOUND only in the container.
        "module": "node16",
        "moduleResolution": "node16",
        "outDir": "./dist",
        "rootDir": "./src",
        "types": ["node"],
        // A deployed app, not a library: no consumer reads these.
        "declaration": false,
        "declarationMap": false,
        // Inside outDir so turbo caches it alongside dist. Left at the package
        // root, a stale tsbuildinfo without its dist made tsc emit nothing.
        "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo"
    },
    "include": ["src/**/*.ts"],
    // Tests are compiled by vitest, not shipped. Emitting them put `import
    // 'vitest'` into the production image.
    "exclude": ["node_modules", "dist", "src/__tests__", "src/**/*.test.ts"]
}
