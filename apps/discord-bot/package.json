{
    "name": "@copilotkit/outpost-discord-bot",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "scripts": {
        "build": "tsc",
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src/",
        "test": "vitest run",
        "register-commands": "tsx src/register-commands.ts"
    },
    "dependencies": {
        "@copilotkit/channels": "^0.1.1",
        "@copilotkit/channels-discord": "^0.0.3",
        "@copilotkit/outpost": "workspace:*",
        "discord.js": "^14.16.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "tsx": "^4.19.0",
        "typescript": "^5.7.0",
        "vitest": "^4.1.4"
    }
}
